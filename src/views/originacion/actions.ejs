    <%- include('../partials/originacion/actionOriginationData.ejs') %>
    <%- include('../partials/originacion/actionPacData.ejs') %>
    <%- include('../partials/originacion/actionsTable.ejs') %>
    <%- include('../partials/originacion/actionExportModal.ejs') %>
    <%- include('../partials/originacion/actionAddModal.ejs') %>
    <%- include('../partials/originacion/actionEditPACModal.ejs') %>
    <% if (locals?.pacData?.estado?.id !== 6 && locals?.pacData?.estado?.id !== 8) { %>
      <%- include('../partials/originacion/actionModifyModal.ejs') %>
    <% } else { %>
      <%- include('../partials/originacion/actionReopenModal.ejs') %>
    <% } %>
  </div>
</section>