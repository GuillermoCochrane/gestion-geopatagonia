<section>
  <%- include('../partials/originacion/actionsNavBar.ejs') %>
  <div class="data-container" data-action="<%= locals?.action %>" id="data-container">
    <%- include('../partials/originacion/actionOriginationData.ejs') %>
    <%- include('../partials/originacion/actionPacData.ejs') %>
    <dialog id="export-modal">
      <h2>Exportar PAC</h2>
      <button id="export-close">Cerrar</button>
    </dialog>
    <%- include('../partials/originacion/actionAddModal.ejs') %>
    <% if (locals?.pacData?.estado?.id !== 6 && locals?.pacData?.estado?.id !== 8) { %>
      <%- include('../partials/originacion/actionModifyModal.ejs') %>
    <% } else { %>
      <dialog id="reopen-modal">
        <h2>Volver a abrir</h2>
        <button id="reopen-close">Cerrar</button>
      </dialog>
    <% } %>
  </div>
</section>