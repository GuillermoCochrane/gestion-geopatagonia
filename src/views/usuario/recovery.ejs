<form action="/usuario/recovery" method="post" id="login-form">

  <label>
    <h4>Email</h4>
    <input type="email" name="email" id="email" value="<%= locals.old?.email %>" autofocus>
    <span id="error-email"><%= locals.errors?.email?.msg  %></span>
  </label>

  <label>
    <h3>Rol</h3>
    <select name="rol_id" id="rol_id">
      <option 
            value="" 
            <%= (!locals.oldData?.rol) && 'selected' %> 
            disabled
      >
        Seleccione su Rol
      </option>
      <%- include('../partials/originacion/dinamicFormOptions.ejs', {
        options: locals?.roles,
        selected: locals?.old && locals?.old?.rol_id,
        keyLabel: 'rol',
        keyValue: 'id',
        emptyMessage: 'No hay roles definidos'
      }) %>
    </select>
    <span id="error-rol_id"><%= locals.errors?.rol_id?.msg  %></span>
  </label>

  <button id="login-btn" type="button">Recuperar Contraseña</button>
  <%- include('../partials/usuarios/notificationModal.ejs') %>
</form>