<form action="/usuario/login" method="post" id="login-form">

  <label>
      <h4>Email</h4>
      <input type="email" name="email" id="email" value="<%= locals.old?.email %>" autofocus>
      <span id="error-email"><%= locals.errors?.email?.msg  %></span>
  </label>
  
  <label>
      <h4>Contraseña</h4>
      <div class="password-container">
          <input type="password" name="password" id="password">
          <i id="toggle-icon" class="fa-regular fa-eye"></i>
      </div>
      <span id="error-password"><%= locals.errors?.password?.msg %></span>
  </label>

  <label class="checkbox">
    <input type="checkbox" name="rememberMe" id="rememberMe" <%= locals.old?.rememberMe && "checked" %>>
    <h4>Recordarme</h4>
  </label>

  <a href="/usuario/recovery">¿Olvidó su contraseña?</a>

  <button id="login-btn">Ingresar</button>
</form>