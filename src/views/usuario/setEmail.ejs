<form action="/usuario/email" method="post" id="login-form">

  <label>
    <h4>Email Actual</h4>
    <input type="email" name="oldEmail" id="oldEmail" value="<%= locals.old?.oldEmail %>">
    <span id="error-oldEmail"><%= locals.errors?.oldEmail?.msg  %></span>
  </label>

  <label>
    <h4>Nuevo Email</h4>
    <input type="email" name="email" id="email" value="<%= locals.old?.email %>">
    <span id="error-email"><%= locals.errors?.email?.msg  %></span>
  </label>

  <label>
    <h4>Repetir Email</h4>
    <input type="email" name="check" id="check" value="<%= locals.old?.check %>">
    <span id="error-check"><%= locals.errors?.check?.msg  %></span>
  </label>

  <button id="set-email-btn">Cambiar Email</button>

</form>