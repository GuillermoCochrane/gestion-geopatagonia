<form action="/usuario/newPassword" method="post" id="new-password-form">
  <label>
      <h4>Contraseña</h4>
      <div class="password-container">
          <input type="password" name="password" id="password">
          <i id="toggle-icon" class="fa-regular fa-eye"></i>
      </div>
      <span id="error-password"><%= locals.errors?.password?.msg %></span>
  </label>

  <label>
      <h4>Repetir Contraseña</h4>
      <div class="password-container">
          <input type="password" name="check" id="check">
          <i id="repeat-toggle-icon" class="fa-regular fa-eye"></i>
      </div>
      <span id="error-check"><%= locals.errors?.check?.msg %></span>
  </label>
  <button id="new-password-btn">Cambiar Contraseña</button>
</form>