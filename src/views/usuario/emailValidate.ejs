<form action="<%= locals?.emailValidation  ? "/usuario/validateEmail" : "/usuario/emailConfirmation"%>" method="post" id="validate-token-form">
  <label>
    <h4>Ingrese su token de <%= locals?.emailValidation ? "validación" : "confirmación" %></h4>
    <input type="text" name="token" id="token" value="<%= locals.old?.token %>" autofocus>
    <span id="error-token"><%= locals.errors?.token?.msg  %></span>
  </label>
  <button id="token-btn">Enviar</button>
</form>