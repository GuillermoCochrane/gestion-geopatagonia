<form action="/usuario/emailConfirmation" method="post" id="validate-token-form">
  <label>
    <h4>Ingrese su token de confirmación</h4>
    <input type="text" name="token" id="token" value="<%= locals.old?.token %>">
    <span id="error-token"><%= locals.errors?.token?.msg  %></span>
  </label>
  <button id="token-btn">Enviar</button>
</form>