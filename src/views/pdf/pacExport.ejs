<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/img/icon.png">
  <title><%= requiere_analisis ? 'PAC' : 'Observación' %> - GeoPatagonia</title>
  <style>
    :root {
      --white: #fff;
      --ice: #ebebeb;
      --font: #4b4b4d;
      --logo: #ED3237;
      --logo-secondary: #A9abae;
      --shadow: rgba(169, 171, 174, 0.4);
      --success: #39b54a;
      --error: orangered;
      --info: #4b9bd9;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      color: var(--font);
      margin: 0;
      padding: 20px;
      line-height: 1.5;
    }

    /* Encabezado */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 15px;
    }

    img.logo {
      margin-inline: auto;
      height: 70px;
    }

    /* Secciones */
    seccion {
      margin-bottom: 25px;
      page-break-inside: avoid;
    }

    h2 {
      background-color: var(--font);
      color: var(--white);
      padding: 8px 15px;
      font-size: 1.2rem;
      margin-bottom: 10px;
      border-radius: 4px;
    }

    /* Tablas */
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0;
    }

    table th, 
    table td {
      padding: 8px;
      border: 1px solid var(--logo-secondary);
      text-align: left;
    }

    table th {
      background-color: var(--font);
      color: var(--white);
    }

    /* Ajustes específicos para PDF */
    @page {
      size: A4;
      margin: 15mm;
    }
  </style>
</head>
<body>
  <header>
    <img class="logo" src="/img/logo.png" alt="Logo GeoPatagonia">
  </header>

  <!-- Sección: Datos de Originación -->
  <section>
    <h2>Datos de Originación</h2>
    <table>
      <tr>
        <th>Fecha de la observación:</th>
        <td><%= originacion.fecha_de_observacion %></td>
        <th>Lugar:</th>
        <td><%= originacion.lugar %></td>
      </tr>
      <tr>
        <th>Origen:</th>
        <td><%= originacion.origen.origen %></td>
        <th>Observador:</th>
        <td><%= originacion.observador.nombre %></td>
      </tr>
      <tr>
        <th>Ente Inspector:</th>
        <td><%= originacion.ente_inspector.ente_inspector %></td>
        <th>Sector:</th>
        <td><%= originacion.sector.sector %></td>
      </tr>
    </table>
  </section>

  <!-- Sección: Datos de Observación -->
  <section>
    <h2>Datos de <%= requiere_analisis ? 'PAC' : 'Observación' %></h2>
    <table>
      <tr>
        <th>Item:</th>
        <td><%= inciso %></td>
        <th>Responsable:</th>
        <td><%= responsable.nombre %></td>
      </tr>
      <tr>
        <th>Fecha requerida:</th>
        <td><%= fecha_requerida %></td>
        <th>Requiere análisis:</th>
        <td><%= requiere_analisis ? 'Sí' : 'No' %></td>
      </tr>
      <tr>
        <th>Fecha negociable:</th>
        <td><%= fecha_negociable ? 'Sí' : 'No' %></td>
        <th>Estado:</th>
        <td><%= estado.estado %></td>
      </tr>
      <tr>
        <th>Descripción:</th>
        <td colspan="3"><%= descripcion %></td>
      </tr>
    </table>
  </section>

  <!-- Sección: Acciones -->
  <section>
    <h2>Acciones</h2>

    <table>
      <thead>
        <tr>
          <th>Identificador</th>
          <th>Responsable de ejecución</th>
          <th>Fecha de Realización</th>
          <th>Acción</th>
        </tr>
      </thead>
      <tbody id="acciones-list">
        <% if (locals?.acciones?.length !== 0) { %>
          <% for (const accion of acciones) { %>
            <tr>
              <td><%= accion.id %></td>
              <td><%= accion.ejecutor.nombre %></td>
              <td><%= accion.fecha_realizacion %></td>
              <td><%= accion.accion %></td>
            </tr>
          <% } %>
        <% } else { %>
            <tr>
              <td colspan="4">No hay acciones registradas</td>  
            </tr>
        <% } %>
      </tbody>
      <tbody></tbody>
    </table>

  </section>

</body>
</html>