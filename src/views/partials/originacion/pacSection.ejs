<section>
  <div id="pac-section">
    <%- include('../buttonsHeader.ejs') %>
    <article id="main-content" class="<%= locals.PACErrors ? "hidden" : "" %>">
      <%- include('./originiacionData.ejs') %>
      <%- include('./pacTable.ejs') %>
    </article>
    <form id="new-content" action="/originacion/observacionPAC" method="POST" enctype="multipart/form-data" class="<%= locals.PACErrors ? "" : "hidden" %>">
      <%- include('./pacForm.ejs') %>
    </form>
  </div>
  <div id="confirm-pac-delete" class="hidden">
    <article>
      <h2>No hay observaciones registradas</h2>
      <h3>Se eliminará la originación. ¿Estás seguro?</h3>
      <nav>
        <button id="pac-delete" >Eliminar</button>
        <button id="pac-cancel" >Cancelar</button>
      </nav>
    </article>
  </div>
  <div id="pac-delete-success" class="hidden">
    <article>
      <h2>La observación se eliminó correctamente</h2>
      <nav>
        <button id="pac-delete-close">Cerrar</button>
      </nav>
    </article>
  </div>
  <div id="pac-error" class="hidden">
    <article>
      <h2>Ocurrió un error al eliminar.</h2>
      <h3>Por favor intente nuevamente.</h3>
      <nav>
        <button id="pac-error-close">Cerrar</button>
      </nav>
    </article>
  </div>
</section>