<%- include('../buttonsHeader.ejs') %>
<article id="main-content" class="<%= locals.PACErrors ? "hidden" : "" %>">
  <%- include('./originiacionData.ejs') %>
  <aside style="border-color: transparent;">
    <button id="edit-originacion-opener">
      Editar originacion
    </button>
  </aside>
  <%- include('./pacTable.ejs') %>
</article>
<form id="new-content" action="/originacion/observacionPAC" method="POST" enctype="multipart/form-data" class="<%= locals.PACErrors ? "" : "hidden" %>">
  <%- include('./pacForm.ejs') %>
</form>
<%- include('./pacPopUp.ejs', {popUp: locals?.confirmPopUp}) %>
<%- include('./pacPopUp.ejs', {popUp: locals?.successPopUp}) %>
<%- include('./pacPopUp.ejs', {popUp: locals?.errorPopUp}) %>
<article id="spinner-modal" class="hidden">
  <figure class="spinner-figure">
    <div class="spinner"></div>
    <figcaption>Cargando...</figcaption>
  </figure>
</article>