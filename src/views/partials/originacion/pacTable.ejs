<table>
  <thead>
    <tr style="border-bottom: 1px solid white;">
      <th colspan="8">
        PACs y Observaciones
      </th>
    </tr>
    <tr>
      <th>Identificador</th>
      <th>Item</th>
      <th>Descripción</th>
      <th>Fecha Requerida</th>
      <th>Requiere Analisis</th>
      <th>Referencia</th>
      <th>Responsable</th>
    </tr>
  </thead>
  <tbody>
    <% if (locals?.observacionesPACs?.length === 0) { %>
      <tr>
        <td colspan="7">
          No hay observaciones / PACs para esta originación
        </td>
      </tr>
    <% } else { %>
      <% for (const data of locals?.observacionesPACs) { %>
        <tr>
          <td><%= data.id %></td>
          <td><%= data.inciso %></td>
          <td><%= data.descripcion %></td>
          <td><%= data.fecha_requerida %></td>
          <td><%= data.requiere_analisis ? "Si" : "No" %></td>
          <td><%= data.referencia ? data.referencia : "-" %></td>
          <td><%= data.responsable.nombre %></td>
        </tr>
      <% } %>
    <% } %>
  </tbody>
</table>