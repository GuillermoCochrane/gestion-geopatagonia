<article id="<%= popUp?.id %>" class="hidden">
  <h2><%= popUp?.title %></h2>
  <% if (popUp?.text) { %>
    <h3><%= popUp?.text %></h3>
  <% } %>
  <nav>
    <% for (const button of popUp?.buttons) { %>
      <button id="<%= button.id %>"><%= button.text %></button>
    <%  } %>
  </nav>
</article>