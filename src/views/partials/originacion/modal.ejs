<dialog id="modal"  <%= locals?.OriginationSaved && "open" %>>
  <header>
    <aside>
    </aside>
    <h2>Nueva Originación</h2>
    <button id="modal-closer">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </header>
  <% if (locals?.OriginationSaved) { %>
    <%- include('./pacSection.ejs') %>
  <% } else { %>
    <form action="/task/originacion/nueva" method="POST" id="nuevaOriginacion">
      <%- include('./originacionForm.ejs') %>
    </form>
  <% } %>
</dialog>