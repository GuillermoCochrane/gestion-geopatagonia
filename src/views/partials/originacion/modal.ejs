<dialog id="modal" data-has-errors="<%= (locals?.originacionErrors || locals.oldData?.originacion_id) ? true : false %>">
  <header>
    <aside>
    </aside>
    <h2>
      <%= locals.oldData?.originacion_id ? "Editar " : "Nueva " %>
      Originación
    </h2>
    <button id="modal-closer">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </header>
  <% if (locals.oldData?.originacion_id) { %>
    <section 
        id="originacion-section" 
        class="<%= locals.oldData?.originacionErrors ? "hidden" : " " %>"
    >
      <%- include('./pacSection.ejs') %>
    </section>
    <form 
        action="/originacion/edit/<%= locals.oldData?.originacion_id %>"
        method="POST" 
        id="nueva-originacion" 
        enctype="multipart/form-data" 
        class="<%= locals.oldData?.originacionErrors ? " " : "hidden" %>"
    >
      <%- include('./originacionForm.ejs', {oldData: locals.originacionData}) %>
    </form>
  <% } else { %>
    <form action="/originacion/" method="POST" id="nueva-originacion" enctype="multipart/form-data">
      <%- include('./originacionForm.ejs') %>
    </form>
  <% } %>
</dialog>