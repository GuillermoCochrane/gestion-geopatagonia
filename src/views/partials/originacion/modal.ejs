<dialog id="modal" data-has-errors="<%= (locals?.originacionErrors) ? true : false %>">
  <header>
    <aside>
    </aside>
    <h2>Nueva Originación</h2>
    <button id="modal-closer">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </header>
  <% if (locals?.OriginationSaved) { %>
    <%- include('./pacSection.ejs') %>
  <% } else { %>
    <form action="/tasks/originacion/nueva" method="POST" id="nuevaOriginacion" enctype="multipart/form-data">
      <%- include('./originacionForm.ejs') %>
    </form>
  <% } %>
</dialog>