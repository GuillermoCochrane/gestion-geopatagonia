<dialog id="modal" data-has-errors="<%= (locals?.originacionErrors || locals.originacionData?.id) ? true : false %>">
  <header>
    <aside>
    </aside>
    <h2>
      <%= locals.originacionData?.id ? "Editar " : "Nueva " %>
      Originación
      <%= locals.originacionData?.id ?  `: ${locals.originacionData?.id}`: "" %>
    </h2>
    <button id="modal-closer">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </header>
  <% if (locals.originacionData?.id) { %>
    <section 
        id="originacion-section" 
        class="<%= locals.oldData?.originacionErrors ? "hidden" : " " %>"
    >
      <%- include('./pacSection.ejs') %>
    </section>
    <form 
        action="/originacion/edit/<%= locals.originacionData?.id %>?_method=PUT"
        method="POST" 
        id="nueva-originacion" 
        enctype="multipart/form-data" 
        class="<%= locals.oldData?.originacionErrors ? " " : "hidden" %>"
    >
      <%- include('./originacionForm.ejs', {oldData: locals.originacionData}) %>
    </form>
    <%- include('./pacPopUp.ejs', {popUp: locals?.confirmPopUp}) %>
    <%- include('./pacPopUp.ejs', {popUp: locals?.successPopUp}) %>
    <%- include('./pacPopUp.ejs', {popUp: locals?.errorPopUp}) %>
    <article id="spinner-modal" class="hidden">
      <figure class="spinner-figure">
        <div class="spinner"></div>
        <figcaption>Cargando...</figcaption>
      </figure>
    </article>
  <% } else { %>
    <form action="/originacion/" method="POST" id="nueva-originacion" enctype="multipart/form-data">
      <%- include('./originacionForm.ejs') %>
    </form>
  <% } %>
  
</dialog>