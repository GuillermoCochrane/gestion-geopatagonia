<details open>
  <summary>
    <h3>Datos de <%= locals?.title %>: <%= locals?.pacData?.id %></h3>
  </summary>
  <article>
    <ul>
      <li>
        <h4>Inciso del formulario: </h4>
        <p><%= locals?.pacData?.inciso_formulario?.inciso %></p>
      </li>
      <li>
        <h4>Fecha requerida: </h4>
        <p><%= locals?.pacData?.display_fecha_requerida %></p>
      </li>
      <li>
        <h4>Fecha Negociable: </h4>
        <p><%= locals?.pacData?.fecha_negociable == true ? 'Si' : 'No' %></p>
      </li>
      <li>
        <h4>Requiere análisis: </h4>
        <p><%= locals?.pacData?.requiere_analisis == true ? 'Si' : 'No' %></p>
      </li>
      <li>
        <h4>Referencia: </h4>
        <p><%= locals?.pacData?.referencia %></p>
      </li>
      <li>
        <h4>Responsable tratamiento: </h4>
        <p><%= locals?.pacData?.responsable?.nombre %></p>
      </li>
      <li>
        <h4>Estado: </h4>
        <p><%= locals?.pacData?.estado?.estado %></p>
      </li>
      <li>
        <h4>Descripción: </h4>
        <p><%= locals?.pacData?.descripcion %></p>
      </li>
      <li>
        <h4>Adjuntos: </h4>
        <p>
          <% if (locals.pacData?.adjuntos.length > 0) { %>
            <% for (const adjunto of locals.pacData.adjuntos) { %>
              <a href="<%= adjunto.archivo %>">
                <%= adjunto.nombre %> 
              </a>
            <% } %>
          <% } else { %>
            No
          <% } %>
        </p>
      </li>
    </ul>
  </article>
</details>