<label>
  <h3>Inciso</h3>
  <select name="inciso_id" id="inciso_id">
    <option 
        value="" 
        <%= (!locals.oldData?.inciso_id) && 'selected' %>
        disabled
    >
      Seleccione el Inciso
    </option>
    <%- include('./dinamicFormOptions.ejs', {
      options: locals?.incisosData,
      selected: locals?.oldData && locals?.oldData?.inciso_id,
      keyLabel: 'inciso',
      keyValue: 'id',
      emptyMessage: 'No hay incisos definidos'
    }) %>
  </select>
  <span id="error-inciso_id"><%= locals.PACErrors?.inciso_id?.msg %></span>
</label>

<label>
  <h3>Responsable</h3>
  <select name="responsable_id" id="responsable_id1">
    <option 
          value="" 
          <%= (!locals.oldData?.responsable_id) && 'selected' %> 
          disabled
    >
      Seleccione el Responsable
    </option>
    <%- include('./dinamicFormOptions.ejs', {
      options: locals?.tratadorData,
      selected: locals?.oldData && locals?.oldData?.responsable_id,
      keyLabel: 'nombre',
      keyValue: 'id',
      emptyMessage: 'No hay tratadores definidos'
    }) %>
  </select>
  <span id="error-responsable_id"><%= locals.PACErrors?.responsable_id?.msg %></span>
</label>

<label>
  <h3>Fecha Requerida</h3>
  <input 
    type="date" 
    name="fecha_requerida" 
    id="fecha_requerida" 
    value="<%= locals.oldData?.fecha_requerida %>"
  >
  <span id="error-fecha_requerida"><%= locals.PACErrors?.fecha_requerida?.msg %></span>
</label>

<label class="checkbox">
  <h3>¿Fecha Negociable?</h3>
  <input 
    type="checkbox" 
    name="fecha_negociable" 
    id="fecha_negociable"
    <%= (locals?.oldData?.fecha_negociable) && 'checked' %>
  >
  <span id="error-fecha_negociable"><%= locals.PACErrors?.fecha_negociable?.msg %></span>
</label>

<label>
  <h3>Descripción</h3>
  <textarea 
    name="descripcion" 
    id="descripcion"
  ><%= locals.oldData?.descripcion %></textarea>
  <span id="error-descripcion"><%= locals.PACErrors?.descripcion?.msg %></span>
</label>

<label class="checkbox">
  <h3>¿Requiere Análisis?</h3>
  <input 
    type="checkbox" 
    name="requiere_analisis" 
    id="requiere_analisis"
    <%= (locals?.oldData?.requiere_analisis) && 'checked' %>
  >
  <span id="error-requiere_analisis"><%= locals.PACErrors?.requiere_analisis?.msg %></span>
</label>

<label>
  <h3>Referencia</h3>
  <input 
    type="text" 
    name="referencia" 
    id="referencia" 
    value="<%= locals.oldData?.referencia %>"
  >
  <span id="error-referencia"><%= locals.PACErrors?.referencia?.msg %></span>
</label>

<label>
  <h3>Adjuntos</h3>
  <input 
    type="file" 
    name="adjunto" 
    id="adjunto" 
    class="input-file"
  >
  <span id="error-adjunto"><%= locals.PACErrors?.adjunto?.msg %></span>
</label>

<input type="hidden" name="originacion_id" id="originacion_id" value="<%= locals.originacionData?.id || locals.oldData?.originacion_id %>">

<aside>
  <button>
    Guardar
  </button>
  <% if (locals?.pacData?.id) { %>
    <button type="button" id="edit-pac-close">
      Cerrar
    </button>
  <% } %>
</aside>