<label>
  <h3>Fecha de observación</h3>
  <input 
        type="date" 
        name="fecha_de_observacion" 
        id="fecha_de_observacion" 
        value="<%= locals.oldData?.fecha_de_observacion %>"
  >
  <span id="error-fecha_de_observacion"><%= locals.originacionErrors?.fecha_de_observacion?.msg  %></span>
</label>

<label>
  <h3>Lugar</h3>
  <input 
        type="text" 
        name="lugar" 
        id="lugar" 
        value="<%= locals.oldData?.lugar %>"
  >
  <span id="error-lugar"><%= locals.originacionErrors?.lugar?.msg  %></span>
</label>

<label>
  <h3>Origen</h3>
  <select name="origen_id" id="origen_id">
    <option 
          value="" 
          <%= (!locals.oldData?.origen_id) && 'selected' %> 
          disabled
    >
      Seleccione el Origen
    </option>
    <%- include('./dinamicFormOptions.ejs', {
      options: locals?.formData && locals?.formData?.origenes,
      selected: locals?.oldData && locals?.oldData?.origen_id,
      keyLabel: 'origen',
      keyValue: 'id',
      emptyMessage: 'No hay origenes definidos'
      }) %>
  </select>
  <span id="error-origen_id"><%= locals.originacionErrors?.origen_id?.msg %></span>
</label>

<label>
  <h3>Observador</h3>
  <select name="observador_id" id="observador_id">
    <option 
          value="" 
          <%= (!locals.oldData?.observador_id) && 'selected' %> 
          disabled
    >
      Seleccione el Observador
    </option>
    <%- include('./dinamicFormOptions.ejs', {
      options: locals?.formData && locals?.formData?.observadores,
      selected: locals?.oldData && locals?.oldData?.observador_id,
      keyLabel: 'nombre',
      keyValue: 'id',
      emptyMessage: 'No hay observadores definidos'
    }) %>
  </select>
  <span id="error-observador_id"><%= locals.originacionErrors?.observador_id?.msg %></span>
</label>

<label>
  <h3>Ente Inspector</h3>
  <select name="ente_inspector_id" id="ente_inspector_id">
    <option 
          value="" 
          <%= (!locals.oldData?.ente_inspector_id) && 'selected' %> 
          disabled
    >
      Seleccione el Ente Inspector
    </option>
    <%- include('./dinamicFormOptions.ejs', {
      options: locals?.formData && locals?.formData?.enteInspectores,
      selected: locals?.oldData && locals?.oldData?.ente_inspector_id,
      keyLabel: 'ente_inspector',
      keyValue: 'id',
      emptyMessage: 'No hay entes inspectores definidos'
    }) %>
  </select>
  <span id="error-ente_inspector_id">
    <%= locals.originacionErrors?.ente_insperctor_id?.msg %>
  </span>
</label>

<label>
  <h3>Sector</h3>
  <select name="sector_id" id="sector_id">
    <option 
        value="" 
        <%= (!locals.oldData?.sector_id) && 'selected' %> 
        disabled
    >
      Seleccione el Sector
    </option>
    <%- include('./dinamicFormOptions.ejs', {
      options: locals?.formData && locals?.formData?.sectores,
      selected: locals?.oldData && locals?.oldData?.sector_id,
      keyLabel: 'sector',
      keyValue: 'id',
      emptyMessage: 'No hay sectores definidos'
    }) %>
  </select>
  <span id="error-sector_id"><%= locals.originacionErrors?.sector_id?.msg %></span>
</label>

<label>
  <h3>Adjunto</h3>
  <input type="file" name="adjunto" id="adjunto" class="input-file">
  <span id="error-adjunto"><%= locals.originacionErrors?.adjunto?.msg %></span>
</label>

<aside>
  <button>
    Guardar
  </button>
</aside>
