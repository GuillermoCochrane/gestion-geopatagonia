<dialog id="modify-modal">
  <h2>Cambiar Responsable</h2>
  <form action="/originacion/observacionPAC/modify/<%= locals?.pacData?.id %>?_method=PUT" method="post" id="modify-form">
    <label>
      <h3>Responsable:</h3>
      <select name="responsable_id" id="responsable_id">
        <% for (const responsable of locals?.responsables) { %>
          <option value="<%= responsable.id %>" <%= responsable.id === locals?.pacData?.responsable_id ? 'selected' : '' %>>
            <%= responsable.nombre %>
          </option>
        <% } %>
      </select>
      <span id="error-responsable_id">
        <%= locals.PACErrors?.responsable_id?.msg %>
      </span>
    </label>
  </form>
  <nav>
    <button id="modify-save"  type="submit" form="modify-form">
      Guardar
    </button>
    <button id="modify-close" type="button">
      Cancelar
    </button>
  </nav>
</dialog>