<section>
  <details <%= locals.filterErrors && 'open' %>>
    <summary>
      <h3>Filtrar Originaciones</h3>
    </summary>
    <form action="/originacion/filtrar" method="POST">
      
      <label>
        <h3>Fecha de inicio de carga</h3>
        <input 
          type="date" 
          name="inicio_carga"
          id="inicio_carga"
          value="<%= locals.oldData?.inicio_carga %>"
        >
        <span id="error-inicio_carga"><%= locals.filterErrors?.inicio_carga?.msg  %></span>
      </label>

      <label>
        <h3>Fecha de fin de carga</h3>
        <input 
          type="date"  
          name="fin_carga"
          id="fin_carga"
          value="<%= locals.oldData?.fin_carga %>"
        >
        <span id="error-fin_carga"><%= locals.filterErrors?.fin_carga?.msg  %></span>
      </label>

      <label>
        <h3>Identificador</h3>
        <select name="id">
          <option value="">Todos</option>
          <%- include('./dinamicFormOptions.ejs', {
            options: locals?.formData && locals?.formData?.originaciones,
            selected: locals?.oldData && locals?.oldData?.id,
            keyLabel: 'id',
            keyValue: 'id',
            emptyMessage: 'No hay originaciones definidas'
          }) %>
        </select>
      </label>

      <label>
        <h3>Ente Inspector</h3>
        <select name="ente_inspector_id">
          <option value="">Todos</option>
          <%- include('./dinamicFormOptions.ejs', {
            options: locals?.formData && locals?.formData?.enteInspectores,
            selected: locals?.oldData && locals?.oldData?.ente_inspector_id,
            keyLabel: 'ente_inspector',
            keyValue: 'id',
            emptyMessage: 'No hay entes inspectores definidos'
          }) %>
        </select>
      </label>

      <label>
        <h3>Sector</h3>
        <select name="sector_id">
          <option value="">Todos</option>
          <%- include('./dinamicFormOptions.ejs', {
            options: locals?.formData && locals?.formData?.sectores,
            selected: locals?.oldData && locals?.oldData?.sector_id,
            keyLabel: 'sector',
            keyValue: 'id',
            emptyMessage: 'No hay sectores definidos'
          }) %>
        </select>
      </label>

      <label>
        <h3>Etapa PAC / Observación</h3>
        <select name="estado_id">
          <option value="">Todos</option>
          <%- include('./dinamicFormOptions.ejs', {
            options: locals?.formData && locals?.formData?.estados,
            selected: locals?.oldData && locals?.oldData?.estado_id,
            keyLabel: 'estado',
            keyValue: 'id',
            emptyMessage: 'No hay estados definidos'
          }) %>
        </select>
      </label>

      <label>
        <h3>Origen</h3>
        <select name="origen_id">
          <option value="">Todos</option>
          <%- include('./dinamicFormOptions.ejs', {
            options: locals?.formData && locals?.formData?.origenes,
            selected: locals?.oldData && locals?.oldData?.origen_id,
            keyLabel: 'origen',
            keyValue: 'id',
            emptyMessage: 'No hay origenes definidos'
          }) %>
        </select>
      </label>

      <!-- Campos que todavía no están en la DB -->
      <label>
        <h3>Formulario</h3>
        <select name="formulario" disabled>
          <option value="">(No disponible)</option>
        </select>
      </label>

      <label>
        <h3>Inciso</h3>
        <select name="inciso" disabled>
          <option value="">(No disponible)</option>
        </select>
      </label>

      <label>
        <h3>Equipo</h3>
        <select name="equipo" disabled>
          <option value="">(No disponible)</option>
        </select>
      </label>

      <label>
        <h3>Tipo de operación</h3>
        <select name="tipo_operacion" disabled>
          <option value="">(No disponible)</option>
        </select>
      </label>

      <aside>
        <button>
          Filtrar
        </button>
      </aside>
    </form>
  </details>
</section>
