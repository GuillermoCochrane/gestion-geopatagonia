<aside>
  <ul>
    <li>
      <h4>Fecha de observación </h4>
      <p><%= locals?.originacionData?.display_fecha_de_observacion %></p>
    </li>
    <li>
      <h4>Lugar: </h4>
      <p><%= locals?.originacionData?.lugar %></p>
    </li>
    <li>
      <h4>Origen: </h4>
      <p><%= locals?.originacionData?.origen?.origen %></p>
    </li>
    <li>
      <h4>Observador:</h4>
      <p><%= locals?.originacionData?.observador?.nombre %></p>
    </li>
    <li>
      <h4>Ente Inspector:</h4>
      <p><%= locals?.originacionData?.ente_inspector?.ente_inspector %></p>
    </li>
    <li>
      <h4>Sector:</h4>
      <p><%= locals?.originacionData?.sector?.sector %></p>
    </li>
    <li>
      <h4>Formulario:</h4>
      <p><%= locals?.originacionData?.formulario?.codigo %></p>
    </li>
    <li>
      <h4>Adjuntos:</h4>
      <p>
        <% if (locals.originacionData?.adjuntos?.length > 0) { %>
          <% for (const adjunto of locals.originacionData.adjuntos) { %>
            <a href="/documents/originacion/<%= adjunto.nombre %>">
              <%= adjunto.nombre %> 
            </a>
          <% } %>
        <% } else { %>
          No
        <% } %>
      </p>
    </li>
  </ul>
</aside>