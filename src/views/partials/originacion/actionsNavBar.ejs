<aside class="sidebar collapsed" id="sidebar">
  <button class="toggle" id="toggle">
    <i class="fas fa-bars fa-lg" id="toggle-icon"></i>
    <span>Menú</span>
  </button>
  <nav class="sidebar-nav">
    <a id="export-action" title="Exportar">
      <i class="fa-solid fa-file-arrow-down fa-lg"></i>
      <span>Exportar</span>
    </a>
    <a id="add-action" title="Añadir tarea">
      <i class="fa-solid fa-plus fa-lg"></i>
      <span>Añadir tarea</span>
    </a>
    <% if (locals?.pacData?.estado?.id !== 6 && locals?.pacData?.estado?.id !== 8) { %>
      <a id="modify-action" title="Cambiar responsable">
        <i class="fa-solid fa-user-pen fa-lg"></i>
        <span>Cambiar Responsable</span>
      </a>
    <% } else { %>
      <a id="reopen-action" title="Reabrir">
        <i class="fa-solid fa-arrow-rotate-left fa-lg fa-rotate-90"></i>
        <span>Reabrir</span>
      </a>
    <% } %>
  </nav>
</aside>