<section>
  <table>
    <thead>
      <tr>
        <th>Identificador</th>
        <th>Fecha</th>
        <th>Fecha de observación</th>
        <th>Descripción</th>
        <th>Origen</th>
        <th>Responsable</th>
        <th>Observador</th>
        <th>Etapa</th>
        <th>Opciones</th>
      </tr>
    </thead>
    <tbody>
      <% if (!locals.pacTableData || locals.pacTableData.length === 0) { %>
        <tr>
          <td colspan="9">No hay observaciones o PACs registradas</td>
        </tr>
      <% } else { %>
        <% for (const rowData of locals?.pacTableData) { %>
          <tr class="<%= (rowData?.estado?.id === 6 || rowData?.estado?.id === 8) ? 'error' : '' %>">
            <td><%= rowData?.id %></td>
            <td><%= rowData?.fecha_requerida %></td>
            <td><%= rowData?.originacion?.fecha_de_observacion %></td>
            <td><%= rowData?.descripcion %></td>
            <td><%= rowData?.originacion?.origen?.origen %></td>
            <td><%= rowData?.responsable?.nombre %></td>
            <td><%= rowData?.originacion?.observador?.nombre %></td>
            <td><%= rowData?.estado?.estado %></td>
            <td>
              <div class="actions-container">
                <a href="/originacion/ver/<%= rowData?.id %>">
                  <i class="fa-solid fa-magnifying-glass fa-lg"></i>
                </a>
                <a href="/originacion/exportar/<%= rowData?.id %>">
                  <i class="fa-solid fa-file-arrow-down fa-lg"></i>
                </a>
                <a href="/originacion/agregar/<%= rowData?.id %>">
                  <i class="fa-solid fa-plus fa-lg"></i>
                </a>
                <% if (rowData?.estado?.id !== 6 && rowData?.estado?.id !== 8) { %>
                  <a href="/originacion/modificar/<%= rowData?.id %>">
                    <i class="fa-solid fa-user-pen fa-lg"></i>
                  </a>
                <% } else { %>
                  <a href="/originacion/reabrir/<%= rowData?.id %>">
                    <i class="fa-solid fa-arrow-rotate-left fa-lg fa-rotate-90"></i>
                  </a>
                <% } %>
              </div>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</section>