<section>
  <table>
    <thead>
      <tr>
        <th>Identificador</th>
        <th>Fecha</th>
        <th>Fecha de observación</th>
        <th>Descripción</th>
        <th>Origen</th>
        <th>Responsable</th>
        <th>Observador</th>
        <th>Etapa</th>
        <th>Opciones</th>
      </tr>
    </thead>
    <tbody>
      <% console.log(locals.pacTableData) %>
      <% if (!locals.pacTableData || locals.pacTableData.length === 0) { %>
        <tr>
          <td colspan="9">No hay observaciones o PACs registradas</td>
        </tr>
      <% } else { %>
        <% for (const rowData of locals?.pacTableData) { %>
          <tr>
            <td><%= rowData?.id %></td>
            <td><%= rowData?.fecha_requerida %></td>
            <td><%= rowData?.originacion?.fecha_de_observacion %></td>
            <td><%= rowData?.descripcion %></td>
            <td><%= rowData?.originacion?.origen?.origen %></td>
            <td><%= rowData?.responsable?.nombre %></td>
            <td><%= rowData?.originacion?.observador?.nombre %></td>
            <td><%= rowData?.estado?.estado %></td>
            <td>
              <a href="/originacion/editar/<%= rowData?.id %>">
                <i class="fas fa-edit"></i>
              </a>
              <a href="/originacion/eliminar/<%= rowData?.id %>">
                <i class="fas fa-trash"></i>
              </a>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</section>