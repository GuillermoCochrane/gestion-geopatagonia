<label>
  <h4>Formulario</h4>
  <select name="formulario_id" id="formulario_id">
    <option value="" <%= (!locals.inciso?.formulario_id) && 'selected' %> disabled>Seleccione el Formulario</option>
    <% for (const formulario of formularios) { %>
      <option value="<%= formulario.id %>" <%= (locals.inciso?.formulario_id == formulario.id) && 'selected'  %> > <%= formulario.codigo %> </option>
    <% } %>
  </select>
  <span id="error-formulario_id"><%= locals.errors?.formulario_id?.msg  %></span>
</label>
<label>
  <h4>Inciso</h4>
  <input type="text" name="inciso" id="inciso" value="<%= locals.inciso?.inciso  %>" autofocus>
  <span id="error-inciso"><%= locals.errors?.inciso?.msg  %></span>
</label>
<label>
  <h4>Descripción</h4>
  <textarea name="descripcion" id="descripcion" ><%= locals.inciso?.descripcion%></textarea>
  <span id="error-descripcion"><%= locals.errors?.descripcion?.msg %></span>
</label>
<%- include(`./submitButton.ejs`) %>