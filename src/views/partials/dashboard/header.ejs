<header class="fixed">
  <figure>
    <img src="/img/logo.png" alt="Logo de Geopatagonia" id="logo">
    <i class="fa-solid fa-xmark" id="menu"></i>
  </figure>
  <h1>
    <a href="/dashboard">
      Panel de control
    </a>
  </h1>
  <aside>
    <figure>
      <img src="/img/default.png" alt="Imagen de perfil de <%= usuario %>" id="perfil">
    </figure>
    <h3>
      <%= usuario  %>
    </h3>
    <form action="/usuario/logout" method="post">
      <button type="submit">
        <i class="fa-solid fa-power-off"></i>
      </button>
    </form>
  </aside>
</header>